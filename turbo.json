{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^generate"] },
    "generate": { "cache": false },
    "lint": {},
    "test": { "dependsOn": ["^generate"], "cache": false }
  }
}
