{
  "name": "sherpa",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@sherpa/server --filter=@sherpa/mobile",
    "dev:server": "pnpm --filter @sherpa/server dev",
    "dev:mobile": "pnpm --filter @sherpa/mobile dev",
    "db:reset": "pnpm --filter @sherpa/db reset",
    "test": "turbo run test",
    "test:e2e": "maestro test apps/mobile/.maestro",
    "evals": "pnpm --filter @sherpa/evals evals",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "auth:allow": "pnpm --filter @sherpa/db auth allow",
    "auth:revoke": "pnpm --filter @sherpa/db auth revoke",
    "auth:roles": "pnpm --filter @sherpa/db auth roles",
    "auth:list": "pnpm --filter @sherpa/db auth list"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
