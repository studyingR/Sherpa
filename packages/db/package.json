{
  "name": "@sherpa/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "node scripts/with-env.mjs prisma generate",
    "push": "node scripts/with-env.mjs prisma db push --skip-generate",
    "reset": "node scripts/with-env.mjs sh -c 'prisma db push --skip-generate && tsx src/seed-cli.ts'",
    "seed": "node scripts/with-env.mjs tsx src/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "node scripts/with-env.mjs vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sherpa/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.20.6"
  },
  "type": "module"
}
