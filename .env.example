# Server
PORT=4000
JWT_SECRET=dev-only-change-me
DATABASE_URL=file:./dev.db
# Fix the seed day (YYYY-MM-DD). Empty = today at seed time.
SEED_TODAY=
# demo: server clock starts at 15:30 on the seed day when it boots; real: wall clock
CLOCK_MODE=demo
SCHEDULER=on
FEATURE_FLAGS_FILE=./config/features.json
REFERRAL_ROUTING_FILE=./config/referral-routing.json

# Modes: mock (default, no network) or openai
LLM_MODE=mock
VOICE_MODE=mock
VOICE_PIPELINE=stt-tts
INTEGRATIONS_MODE=mock

# OpenAI (server-side only; synthetic data only). Model names are config, never code.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_REALTIME_MODEL=
LLM_TIMEOUT_MS=20000
# Route LLM traffic through the bank's approved gateway (M9). Headers as JSON.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_HEADERS=

# Live integrations (INTEGRATIONS_MODE=live) — never commit real values
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=
GRAPH_TENANT_ID=
GRAPH_ACCESS_TOKEN=
NCINO_BASE_URL=
NCINO_API_KEY=
ACBS_BASE_URL=
ACBS_API_KEY=
CORE_DEPOSITS_BASE_URL=
CORE_DEPOSITS_API_KEY=
PRECISION_LENDER_BASE_URL=
PRECISION_LENDER_API_KEY=

# Mobile (Expo) — optional; by default the app uses the Expo dev host on port 4000
EXPO_PUBLIC_API_URL=
